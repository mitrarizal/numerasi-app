<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F9FF"
    android:orientation="vertical">

    <!-- WebView Game (Otomatis menyesuaikan tinggi saat Native Ad tampil di bawah) -->
    <WebView
        android:id="@+id/game_webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Kontainer Native Advanced (Hanya tampil di Layar Home saat setGameplayState(false)) -->
    <FrameLayout
        android:id="@+id/native_ad_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E2E8F0"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone" />

</LinearLayout>
